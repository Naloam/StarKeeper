# GitHub OAuth（部署时需要配置，client_id 是公开的）
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret_here
VITE_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# GitHub Personal Access Token（仅本地开发用，部署后不需要）
VITE_GITHUB_TOKEN=

# AI API Keys（可选 — 留空则由用户在设置页面自行配置）
VITE_DASHSCOPE_API_KEY=
VITE_SILICONFLOW_API_KEY=

# App Config（可选）
VITE_APP_NAME=StarKeeper
VITE_APP_URL=http://localhost:3000
