# GitHub OAuth
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret_here
VITE_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# GitHub Personal Access Token (for development)
VITE_GITHUB_TOKEN=your_github_personal_access_token_here

# DashScope API (阿里云通义千问)
VITE_DASHSCOPE_API_KEY=your_dashscope_api_key_here
VITE_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc

# App Config
VITE_APP_NAME=StarKeeper
VITE_APP_URL=http://localhost:3000
