# Optional. PAT login works without these values.
# Use a GitHub OAuth App registered for the exact deployment origin.
VITE_GITHUB_CLIENT_ID=
VITE_GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback

# Server-only. Used by the Vercel OAuth callback function.
GITHUB_CLIENT_SECRET=

# Optional branding.
VITE_APP_NAME=StarKeeper
VITE_APP_URL=http://localhost:3000
